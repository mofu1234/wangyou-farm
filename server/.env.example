# 数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=farm_game

# JWT 配置
JWT_SECRET=your_jwt_secret_key_here_at_least_32_chars
JWT_EXPIRES_IN=7d

# 管理员后台配置
# 注意：ADMIN_PASSWORD_HASH 需要用 bcrypt 加密后的哈希值
# 生成方式：node -e "const bcrypt=require('bcryptjs');bcrypt.hash('your_password',10).then(h=>console.log(h))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2a$10$example_hash_here_replace_me

# CORS 配置（可选，不设置则默认 localhost:3000）
# CORS_ORIGIN=https://yourdomain.com

# 服务端口
PORT=3000
