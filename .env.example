# 忘忧农场 - 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# 数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=farm_game

# JWT 配置
JWT_SECRET=your_jwt_secret_key_here_at_least_32_chars
JWT_EXPIRES_IN=7d

# 管理员后台配置
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2a$10$example_hash_here_replace_me

# CORS 配置（可选）
CORS_ORIGIN=https://yourdomain.com

# 服务端口
PORT=3000
